{
  "name": "vinyl-picks",
  "version": "0.1.0",
  "private": true,
  "description": "Automates Vinyl Picks community playlists: Instagram comments -> AI parsing -> ranked Spotify/Apple Music playlists.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "pipeline": "node dist/pipeline/run-weekly-pipeline.js",
    "pipeline:dev": "tsx src/pipeline/run-weekly-pipeline.ts",
    "import:comments": "tsx scripts/import-manual-comments.ts",
    "setup:spotify": "tsx scripts/setup-spotify-auth.ts",
    "setup:apple-music": "tsx scripts/setup-apple-music-auth.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "open": "^10.1.0",
    "openai": "^4.67.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
