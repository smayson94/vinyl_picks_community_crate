# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Spotify (https://developer.spotify.com/dashboard) -- create an app, add
# http://127.0.0.1:8888/callback as a Redirect URI, then run `npm run setup:spotify`
# to populate SPOTIFY_REFRESH_TOKEN below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=

# Instagram (see README for how to generate this via the Meta App Dashboard).
# Optional: leave unset to keep using the CSV-import fallback (`npm run import:comments`).
INSTAGRAM_ACCESS_TOKEN=

# Apple Music (see README for how to create a Media ID + private key in the
# Apple Developer portal, then run `npm run setup:apple-music`).
# Optional: leave all four unset to skip Apple Music mirroring entirely.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_USER_TOKEN=
APPLE_MUSIC_STOREFRONT=us

# Path to the SQLite database file
DATABASE_PATH=./data/vinylpicks.db

# --- Future milestones (not required yet) ---
# EMAIL_TO=
# RESEND_API_KEY=
